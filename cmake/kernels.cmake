# Embeds every kernels/prebuilt/<algo>_<arch>.<ext> blob and generates a table of them (kernel_table.cpp).
file(GLOB XM_KERNEL_BLOBS CONFIGURE_DEPENDS
  ${CMAKE_SOURCE_DIR}/kernels/prebuilt/*.hsaco
  ${CMAKE_SOURCE_DIR}/kernels/prebuilt/*.cubin
  ${CMAKE_SOURCE_DIR}/kernels/prebuilt/*.ptx)
list(SORT XM_KERNEL_BLOBS)

set(XM_KERNEL_HEADERS "")
set(XM_KERNEL_INCLUDES "")
set(XM_KERNEL_ENTRIES "")
foreach(blob ${XM_KERNEL_BLOBS})
  get_filename_component(fname ${blob} NAME)
  get_filename_component(stem ${blob} NAME_WE)
  get_filename_component(ext ${blob} EXT)
  # <algo>_<arch>: the algorithm is everything before the first "_gfx", "_sm_" or "_compute_".
  string(REGEX MATCH "^(.+)_(gfx[0-9a-f]+|sm_[0-9]+|compute_[0-9]+)$" _ ${stem})
  if(NOT CMAKE_MATCH_1)
    message(FATAL_ERROR "kernel blob ${fname} is not named <algo>_<arch>.<ext>")
  endif()
  set(algo ${CMAKE_MATCH_1})
  set(arch ${CMAKE_MATCH_2})
  string(MAKE_C_IDENTIFIER "k_${stem}${ext}" sym)
  if(ext STREQUAL ".hsaco")
    set(vendor "xm::gpu::Vendor::Amd")
  else()
    set(vendor "xm::gpu::Vendor::Nvidia")
  endif()
  add_custom_command(OUTPUT ${XM_GEN}/${sym}.hpp
    COMMAND ${CMAKE_COMMAND} -DIN=${blob} -DOUT=${XM_GEN}/${sym}.hpp -DNAME=${sym} -P ${CMAKE_SOURCE_DIR}/cmake/embed.cmake
    DEPENDS ${blob} ${CMAKE_SOURCE_DIR}/cmake/embed.cmake VERBATIM)
  list(APPEND XM_KERNEL_HEADERS ${XM_GEN}/${sym}.hpp)
  string(APPEND XM_KERNEL_INCLUDES "#include \"${sym}.hpp\"\n")
  string(APPEND XM_KERNEL_ENTRIES "    {\"${algo}\", ${vendor}, \"${arch}\", ${sym}_bytes, ${sym}_size},\n")
endforeach()

file(WRITE ${XM_GEN}/kernel_table.cpp.in
"// Generated by cmake/kernels.cmake from kernels/prebuilt/. Do not edit.\n#include \"gpu/kernels.hpp\"\n${XM_KERNEL_INCLUDES}\nnamespace xm::gpu {\nconst std::vector<KernelBlob>& kernel_blobs() {\n  static const std::vector<KernelBlob> blobs = {\n${XM_KERNEL_ENTRIES}  };\n  return blobs;\n}\n}  // namespace xm::gpu\n")
configure_file(${XM_GEN}/kernel_table.cpp.in ${XM_GEN}/kernel_table.cpp COPYONLY)
